function openai_field_automator_widget_action_submit($form, &$form_state) {
  module_load_include('inc', 'openai_field_automator', 'includes/OpenAIFieldAutomatorWidgetActions');
  _openai_field_automator_widget_action_submit($form, $form_state);
}

