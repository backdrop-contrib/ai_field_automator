// ---------------------------------------------------------------------------
// Config helpers
// ---------------------------------------------------------------------------

/**
 * Loads the automator config for a specific field instance.
 * Result is statically cached; reset with backdrop_static_reset().
 *
 * @param string $entity_type
 * @param string $bundle
 * @param string $field_name
 *
 * @return array|null  Config data array, or NULL if not configured.
 */
function openai_field_automator_load_field_config($entity_type, $bundle, $field_name) {
  $cache = &backdrop_static(__FUNCTION__, []);
  $key   = $entity_type . '.' . $bundle . '.' . $field_name;
  if (!array_key_exists($key, $cache)) {
    $cache[$key] = config_get('openai_field_automator.' . $key) ?: NULL;
  }
  return $cache[$key];
}

/**
 * Returns provider-grouped model options for a select element.
 *
 * Returns a nested array [Provider Label => [provider/model_id => label]]
 * which Backdrop renders as <optgroup> elements in the select widget.
 * The stored value is the fully-qualified "provider/model_id" string that
 * openai_chat() and openai_get_api_for_model() already understand.
 */
function openai_field_automator_model_options($automator_type = '') {
  $callback = 'openai_get_all_chat_models';
  if (in_array($automator_type, ['text_to_image', 'media_image_generation', 'video_to_image'], TRUE)) {
    $callback = 'openai_get_all_image_models';
  }
  elseif (in_array($automator_type, ['text_to_speech', 'media_audio_generation'], TRUE)) {
    $callback = 'openai_get_all_tts_models';
  }
  elseif (in_array($automator_type, ['audio_to_text', 'video_to_text'], TRUE)) {
    $callback = 'openai_get_all_models';
  }

  if (!function_exists($callback)) {
    return [];
  }
  try {
    return $callback();
  }
  catch (Exception $e) {
    watchdog('openai_field_automator', 'Could not load model list: @msg', ['@msg' => $e->getMessage()], WATCHDOG_WARNING);
    return [];
  }
}

/**
 * Ensures Backdrop core token functions are available.
 *
 * @return bool
 *   TRUE if token replacement support is available.
 */
function openai_field_automator_tokens_available() {
  if (!function_exists('token_replace')) {
    require_once BACKDROP_ROOT . '/core/includes/token.inc';
  }
  return function_exists('token_replace');
}

/**
 * Renders a token-based prompt for an entity, if token support is available.
 *
 * @param string $template
 *   Token template.
 * @param object $entity
 *   Entity object.
 * @param string $entity_type
 *   Entity type machine name.
 *
 * @return string
 *   Rendered prompt string (or original template if Token is unavailable).
 */
function openai_field_automator_render_token_prompt($template, $entity, $entity_type) {
  if (!openai_field_automator_tokens_available()) {
    return $template;
  }

  $token_type = ($entity_type === 'taxonomy_term') ? 'term' : $entity_type;
  $data = [$token_type => $entity];
  return token_replace($template, $data, ['clear' => TRUE]);
}

/**
 * Removes generated values rejected by a plugin verifier.
 *
 * @param OpenAIFieldAutomatorInterface $plugin
 *   Plugin instance.
 * @param object $entity
 *   Entity being processed.
 * @param string $field_name
 *   Destination field name.
 * @param array $config
 *   Automator config.
 * @param array $values
 *   Generated values.
 *
 * @return array
 *   Filtered values array.
 */
function openai_field_automator_filter_generated_values($plugin, $entity, $field_name, array $config, array $values) {
  if (!$plugin || !method_exists($plugin, 'verifyValue')) {
    return $values;
  }

  foreach ($values as $key => $value) {
    if (!$plugin->verifyValue($entity, $value, $field_name, $config)) {
      unset($values[$key]);
    }
  }

  return array_values($values);
}
