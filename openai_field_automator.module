  return _openai_field_automator_widget_action_ajax($form, $form_state);
}

/**
 * Validate callback proxy for field_ui_field_edit_form.
 */
function openai_field_automator_field_edit_form_validate($form, &$form_state) {
  module_load_include('inc', 'openai_field_automator', 'includes/OpenAIFieldAutomatorFieldForm');
  _openai_field_automator_field_edit_form_validate($form, $form_state);
}

/**
 * Submit callback proxy for field_ui_field_edit_form.
 */
function openai_field_automator_field_edit_form_submit($form, &$form_state) {
  module_load_include('inc', 'openai_field_automator', 'includes/OpenAIFieldAutomatorFieldForm');
  _openai_field_automator_field_edit_form_submit($form, $form_state);

  // Auto-create or remove the status field based on whether any automators
  // are now configured on this bundle.
  $instance = $form['#instance'];
  if (!empty($instance['entity_type']) && !empty($instance['bundle'])) {
    OpenAIFieldAutomatorStatusField::modifyStatusField($instance['entity_type'], $instance['bundle']);
  }
}

// ---------------------------------------------------------------------------
// Cleanup when a field instance is deleted
// ---------------------------------------------------------------------------

/**
 * Implements hook_field_delete_instance().
 */
function openai_field_automator_field_delete_instance($instance) {
  // Don't process deletion of the status field itself.
  if ($instance['field_name'] === OpenAIFieldAutomatorStatusField::FIELD_NAME) {
    return;
  }

  $key = 'openai_field_automator.'
    . $instance['entity_type'] . '.'
    . $instance['bundle'] . '.'
    . $instance['field_name'];
  $c = config($key);
  if (!$c->isNew()) {
    $c->delete();
  }

  // Check if the status field should be removed now.
  OpenAIFieldAutomatorStatusField::modifyStatusField($instance['entity_type'], $instance['bundle']);
}

// ---------------------------------------------------------------------------
// Entity save hooks
// ---------------------------------------------------------------------------

/**
 * Implements hook_node_presave().
 */
function openai_field_automator_node_presave($node) {
  if (!openai_field_automator_entity_can_save_toggle()) {
    return;
  }
  if (openai_field_automator_is_queue_processing()) {
    return;
  }
  $runner = new OpenAIFieldAutomatorRunner();
  $runner->processEntity('node', $node, ['workers' => ['direct', 'batch']]);
}

/**
 * Implements hook_taxonomy_term_presave().
 */
function openai_field_automator_taxonomy_term_presave($term) {
  if (!openai_field_automator_entity_can_save_toggle()) {
    return;
  }
  if (openai_field_automator_is_queue_processing()) {
    return;
  }
  $runner = new OpenAIFieldAutomatorRunner();
  $runner->processEntity('taxonomy_term', $term, ['workers' => ['direct', 'batch']]);
}

/**
 * Implements hook_node_insert().
 */
function openai_field_automator_node_insert($node) {
  $runner = new OpenAIFieldAutomatorRunner();
  $runner->enqueueEntity('node', $node);
}

/**
 * Implements hook_node_update().
 */
function openai_field_automator_node_update($node) {
  $runner = new OpenAIFieldAutomatorRunner();
  $runner->enqueueEntity('node', $node);
}

/**
 * Implements hook_form_alter().
 *
 * Adds post-save batch handling for worker_type=batch on node edit forms.
 */
function openai_field_automator_form_alter(&$form, &$form_state, $form_id) {
  if (!empty($form['#node']) && is_object($form['#node'])) {
    if (!in_array('openai_field_automator_node_form_capture_preview_submit', $form['#submit'], TRUE)) {
      array_unshift($form['#submit'], 'openai_field_automator_node_form_capture_preview_submit');
    }
    if (!in_array('openai_field_automator_node_form_submit', $form['#submit'], TRUE)) {
      $form['#submit'][] = 'openai_field_automator_node_form_submit';
    }
    module_load_include('inc', 'openai_field_automator', 'includes/OpenAIFieldAutomatorWidgetActions');
    _openai_field_automator_node_form_add_taxonomy_widget_action_buttons($form, $form_state);
  }
}

/**
 * Node form pre-submit handler to capture unsaved rendered text context.
 */
function openai_field_automator_node_form_capture_preview_submit($form, &$form_state) {
  $node = !empty($form_state['node']) && is_object($form_state['node']) ? $form_state['node'] : ($form['#node'] ?? NULL);
  if (!$node || empty($node->type) || empty($form_state['values']) || !is_array($form_state['values'])) {
    return;
  }

  $preview_text = openai_field_automator_extract_node_preview_text_from_form_state($form_state['values'], $node->type);
  if ($preview_text !== '') {
    $node->openai_field_automator_preview_text = $preview_text;
    if (!empty($form_state['node']) && is_object($form_state['node'])) {
      $form_state['node']->openai_field_automator_preview_text = $preview_text;
    }
  }
}

/**
 * Node form submit handler for batch worker mode.
 */
function openai_field_automator_node_form_submit($form, &$form_state) {
  if (empty($form_state['node']) || empty($form_state['node']->nid)) {
    return;
  }
  $node = $form_state['node'];
  $bundle = $node->type;

  $instances = field_info_instances('node', $bundle);
  if (empty($instances)) {
    return;
  }

  $operations = [];
  foreach (array_keys($instances) as $field_name) {
    $config = openai_field_automator_load_field_config('node', $bundle, $field_name);
    if (!empty($config['enabled']) && (($config['worker_type'] ?? 'direct') === 'batch')) {
      $operations[] = ['openai_field_automator_batch_process_field', ['node', (int) $node->nid, $field_name]];
    }
  }

  if (empty($operations)) {
    return;
  }

  $batch = [
    'title' => t('Running AI Automators'),
    'operations' => $operations,
    'finished' => 'openai_field_automator_batch_finished',
    'progress_message' => t('Processed @current of @total fields...'),
    'error_message' => t('AI Automator batch processing encountered an error.'),
  ];
  batch_set($batch);
}

