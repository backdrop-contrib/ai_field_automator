/**
 * Implements hook_cron_queue_info().
 */
function openai_field_automator_cron_queue_info() {
  return [
    'openai_field_automator_queue' => [
      'worker callback' => 'openai_field_automator_queue_worker',
      'time' => 30,
    ],
  ];
}

/**
 * Queue worker callback for queue/cron automator tasks.
 */
function openai_field_automator_queue_worker($data) {
  $entity_type = $data['entity_type'] ?? '';
  $entity_id = $data['entity_id'] ?? 0;
  if (empty($entity_type) || empty($entity_id)) {
    return;
  }

  $loaded = entity_load($entity_type, [$entity_id]);
  $entity = $loaded ? reset($loaded) : NULL;
  if (!$entity) {
    return;
  }

  list(, , $bundle) = entity_extract_ids($entity_type, $entity);
  if (empty($bundle)) {
    return;
  }

  $runner = new OpenAIFieldAutomatorRunner();
  $runner->processEntity($entity_type, $entity, [
    'workers' => ['queue_cron'],
  ]);

  // Avoid recursive queueing/presave loops when saving from queue worker.
  openai_field_automator_entity_can_save_toggle(FALSE);
  openai_field_automator_set_queue_processing(TRUE);
  try {
    if ($entity_type === 'node') {
      node_save($entity);
    }
    elseif ($entity_type === 'taxonomy_term') {
      taxonomy_term_save($entity);
    }
    elseif (method_exists($entity, 'save')) {
      $entity->save();
    }
    else {
      entity_get_controller($entity_type)->save($entity);
    }
  }
  finally {
    openai_field_automator_set_queue_processing(FALSE);
    openai_field_automator_entity_can_save_toggle(TRUE);
  }
}

/**
 * Batch operation callback for one field.
 */
function openai_field_automator_batch_process_field($entity_type, $entity_id, $field_name, &$context) {
  if ($entity_type !== 'node') {
    return;
  }
  $node = node_load($entity_id);
  if (!$node) {
    return;
  }

  $runner = new OpenAIFieldAutomatorRunner();
  $runner->processEntity('node', $node, [
    'workers' => ['batch'],
    'specific_field' => $field_name,
  ]);

  // Save without triggering automator presave recursion.
  openai_field_automator_entity_can_save_toggle(FALSE);
  try {
    node_save($node);
  }
  finally {
    openai_field_automator_entity_can_save_toggle(TRUE);
  }

  $context['message'] = t('Processed field @field', ['@field' => $field_name]);
}

/**
 * Batch finished callback.
 */
function openai_field_automator_batch_finished($success, $results, $operations) {
  if ($success) {
    backdrop_set_message(t('AI Automator batch processing completed.'));
  }
  else {
    backdrop_set_message(t('AI Automator batch processing failed.'), 'error');
  }
}

/**
 * Extracts aggregate unsaved text from node form values, including paragraphs.
 */
function openai_field_automator_extract_node_preview_text_from_form_state(array $values, $bundle) {
  if (empty($bundle) || !function_exists('field_info_instances')) {
    return '';
  }

  $chunks = [];
  if (!empty($values['title']) && is_scalar($values['title'])) {
    $title = trim(strip_tags((string) $values['title']));
    if ($title !== '') {
      $chunks[] = $title;
    }
  }

  $instances = field_info_instances('node', $bundle);
  foreach ($instances as $field_name => $instance) {
    if (in_array($field_name, ['revision_log', 'revision_log_message'], TRUE)) {
      continue;
    }
    if (empty($values[$field_name])) {
      continue;
    }
    openai_field_automator_collect_text_recursive($values[$field_name], $chunks);
  }

  $chunks = array_values(array_unique(array_filter(array_map('trim', $chunks))));
  return implode("\n\n", $chunks);
}

/**
 * Recursively collects text fragments from nested form value arrays.
 */
function openai_field_automator_collect_text_recursive($value, array &$out) {
  if (is_string($value)) {
    // Strip tags then decode HTML entities so &nbsp; and similar don't appear
    // verbatim in the collected text.
    $candidate = trim(html_entity_decode(strip_tags($value), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
    if ($candidate !== '' && !preg_match('/^\d+$/', $candidate)) {
      $out[] = $candidate;
    }
    return;
  }

  if (!is_array($value)) {
    return;
  }

  $skip_keys = [
    'format' => TRUE,
    'summary_format' => TRUE,
    // Skip the 'summary' sub-key of text_with_summary fields — it holds the
    // manually-entered teaser text, which duplicates the main 'value' content.
    'summary' => TRUE,
    'weight' => TRUE,
    'delta' => TRUE,
    'item_id' => TRUE,
    'revision_id' => TRUE,
    'bundle' => TRUE,
    'actions' => TRUE,
    'add_more' => TRUE,
    'remove' => TRUE,
    'open' => TRUE,
    '_weight' => TRUE,
    'fid' => TRUE,
    'uid' => TRUE,
    'nid' => TRUE,
    'tid' => TRUE,
    'target_id' => TRUE,
    'openai_field_automator_actions' => TRUE,
  ];

  foreach ($value as $key => $item) {
    if (is_string($key) && isset($skip_keys[$key])) {
      continue;
    }
    openai_field_automator_collect_text_recursive($item, $out);
  }
}

/**
 * Sets queue-processing guard flag for this request.
 */
function openai_field_automator_set_queue_processing($processing) {
  $flag = &backdrop_static(__FUNCTION__, FALSE);
  $flag = (bool) $processing;
}

/**
 * Returns TRUE while queue worker is internally saving entities.
 */
function openai_field_automator_is_queue_processing() {
  $flag = &backdrop_static('openai_field_automator_set_queue_processing', FALSE);
  return (bool) $flag;
}

/**
 * Global toggle for save-time automator processing.
 *
 * Similar to Drupal ai_automators save toggle behavior.
 */
function openai_field_automator_entity_can_save_toggle($new_toggle = NULL) {
  $toggle = &backdrop_static(__FUNCTION__, TRUE);
  if ($new_toggle !== NULL) {
    $toggle = (bool) $new_toggle;
  }
  return (bool) $toggle;
}

// ---------------------------------------------------------------------------
// Plugin registry
// ---------------------------------------------------------------------------

/**
 * Returns all registered automator type definitions, cached for the request.
 *
 * Each definition array has keys:
 *   - label       (string)  Human-readable name.
 *   - description (string)  Optional.
 *   - field_types (array)   Backdrop field type machine names this handles.
 *   - class       (string)  PHP class name implementing OpenAIFieldAutomatorInterface.
 *   - file        (string)  Absolute path to the file defining the class.
 *
 * Any module can add types via hook_openai_field_automator_type_info().
 *
 * @return array Keyed by plugin id.
 */
function openai_field_automator_get_types() {
  $types = &backdrop_static(__FUNCTION__);
  if (isset($types)) {
    return $types;
  }
  $types = module_invoke_all('openai_field_automator_type_info');
  backdrop_alter('openai_field_automator_type_info', $types);
  return $types;
}

/**
 * Instantiates an automator plugin by type id.
 *
 * @param string $type_id
 * @param array $definition
 *
 * @return OpenAIFieldAutomatorInterface|null
 */
function openai_field_automator_load_plugin($type_id, array $definition) {
  if (!empty($definition['file']) && file_exists($definition['file'])) {
    require_once $definition['file'];
  }
  $class = $definition['class'];
  if (!class_exists($class)) {
    watchdog('openai_field_automator', 'Plugin class %class not found for type %id.', [
      '%class' => $class,
      '%id'    => $type_id,
    ], WATCHDOG_ERROR);
    return NULL;
  }
  return new $class();
}

