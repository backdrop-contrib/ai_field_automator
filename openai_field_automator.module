/**
 * Implements hook_permission().
 */
function openai_field_automator_permission() {
  return [
    'administer openai field automator' => [
      'title'       => t('Administer OpenAI Field Automator'),
      'description' => t('Manage per-field AI automator settings.'),
    ],
  ];
}

// ---------------------------------------------------------------------------
// Menu (overview only)
// ---------------------------------------------------------------------------

/**
 * Implements hook_menu().
 */
function openai_field_automator_menu() {
  $items = [];

  $items['admin/config/openai/field-automator'] = [
    'title'            => 'Field Automator',
    'description'      => 'Overview of all fields with AI Automator enabled.',
    'page callback'    => 'openai_field_automator_overview_page',
    'access arguments' => ['administer openai field automator'],
  ];

  $items['admin/config/openai/field-automator/overview'] = [
    'title'  => 'Overview',
    'type'   => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  ];

  // Standalone chain route (for direct links from the overview page).
  $items['admin/config/openai/field-automator/chain/%/%'] = [
    'title'            => 'Automator Chain',
    'description'      => 'Reorder automators for a content type.',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['openai_field_automator_chain_form', 5, 6],
    'access arguments' => ['administer openai field automator'],
    'file'             => 'includes/OpenAIFieldAutomatorChainForm.inc',
  ];

  // Add "AI Automator Run Order" local task tab on each entity bundle's
  // admin page (alongside "Manage fields" and "Manage display").
  foreach (entity_get_info() as $entity_type => $entity_info) {
    if (empty($entity_info['fieldable'])) {
      continue;
    }
    foreach ($entity_info['bundles'] as $bundle_name => $bundle_info) {
      if (!isset($bundle_info['admin']['path'])) {
        continue;
      }
      $path = $bundle_info['admin']['path'];

      // Determine the bundle argument position (same logic as field_ui).
      if (isset($bundle_info['admin']['bundle argument'])) {
        $bundle_arg = $bundle_info['admin']['bundle argument'];
      }
      else {
        $bundle_arg = $bundle_name;
      }

      $items["$path/automator-chain"] = [
        'title'            => 'AI Automator Run Order',
        'page callback'    => 'backdrop_get_form',
        'page arguments'   => ['openai_field_automator_chain_form', $entity_type, $bundle_arg],
        'access arguments' => ['administer openai field automator'],
        'type'             => MENU_LOCAL_TASK,
        'weight'           => 100,
        'file'             => 'includes/OpenAIFieldAutomatorChainForm.inc',
      ];
    }
  }

  return $items;
}

/**
 * Implements hook_theme().
 */
function openai_field_automator_theme() {
  return [
    'openai_field_automator_chain_table' => [
      'render element' => 'element',
      'file' => 'includes/OpenAIFieldAutomatorChainForm.inc',
    ],
  ];
}

/**
 * Preprocesses the chain form to use the custom table theme for the items.
 */
function openai_field_automator_form_openai_field_automator_chain_form_alter(&$form, &$form_state) {
  if (isset($form['items'])) {
    $form['items']['#theme'] = 'openai_field_automator_chain_table';
  }
}

/**
 * Page callback: overview of all active automator configs.
 */
function openai_field_automator_overview_page() {
  $configs = config_get_names_with_prefix('openai_field_automator.');
  $rows = [];
  $bundles_seen = [];

  foreach ($configs as $config_name) {
    $c = config_get($config_name);
    if (empty($c) || empty($c['enabled'])) {
      continue;
    }
    $entity_type = $c['entity_type'];
    $bundle      = $c['bundle'];
    $field_name  = $c['field_name'];

    $bundles_seen["{$entity_type}/{$bundle}"] = [
      'entity_type' => $entity_type,
      'bundle' => $bundle,
    ];

    // Link directly to field edit for node bundles.
    $field_cell = check_plain($field_name);
    if ($entity_type === 'node') {
      $edit_path = "admin/structure/types/manage/{$bundle}/fields/{$field_name}";
      $field_cell = l($field_name, $edit_path);
    }

    // Chain link for the bundle.
    $chain_link = '';
    if ($entity_type === 'node') {
      $chain_link = l(t('Run order'), "admin/structure/types/manage/{$bundle}/automator-chain");
    }
    else {
      $chain_link = l(t('Run order'), "admin/config/openai/field-automator/chain/{$entity_type}/{$bundle}");
    }

    $label = !empty($c['label']) ? $c['label'] : '';

    $rows[] = [
      check_plain($label),
      check_plain($entity_type),
      check_plain($bundle),
      $field_cell,
      check_plain($c['automator_type']),
      check_plain($c['worker_type'] ?? 'direct'),
      check_plain($c['weight'] ?? 0),
      check_plain($c['model'] ?? ''),
      $chain_link,
    ];
  }

  if (empty($rows)) {
    return '<p>' . t('No AI Automators configured yet. Edit any field on a content type to enable one.') . '</p>';
  }

  // Sort by entity_type, bundle, weight.
  usort($rows, function ($a, $b) {
    if ($a[1] !== $b[1]) return strcmp($a[1], $b[1]);
    if ($a[2] !== $b[2]) return strcmp($a[2], $b[2]);
    return (int) strip_tags($a[6]) - (int) strip_tags($b[6]);
  });

  return theme('table', [
    'header' => [t('Label'), t('Entity type'), t('Bundle'), t('Field'), t('Automator type'), t('Worker'), t('Weight'), t('Model'), t('Run order')],
    'rows'   => $rows,
  ]);
}

// ---------------------------------------------------------------------------
// Field instance edit form integration
// ---------------------------------------------------------------------------

/**
 * Implements hook_form_FORM_ID_alter() for field_ui_field_edit_form.
 */
function openai_field_automator_form_field_ui_field_edit_form_alter(&$form, &$form_state, $form_id) {
  if (!empty($form['#field']['field_name']) && $form['#field']['field_name'] === OpenAIFieldAutomatorStatusField::FIELD_NAME) {
    // Avoid list.module default-value widget assumptions for this locked
    // internal field.
    $form['#instance']['default_value_function'] = 'openai_field_automator_status_default_value';
  }

  module_load_include('inc', 'openai_field_automator', 'includes/OpenAIFieldAutomatorFieldForm');
  _openai_field_automator_field_edit_form_alter($form, $form_state);
}

/**
 * Default value callback for the internal status field.
 */
function openai_field_automator_status_default_value($entity_type, $entity, $field, $instance, $langcode) {
  return [
    ['value' => OpenAIFieldAutomatorStatusField::STATUS_PENDING],
  ];
}

/**
 * Implements hook_field_widget_form_alter().
 *
 * Adds an on-demand "Generate with AI" button to supported widgets when the
 * destination field has an enabled automator configuration.
 */
function openai_field_automator_field_widget_form_alter(&$element, &$form_state, $context) {
  module_load_include('inc', 'openai_field_automator', 'includes/OpenAIFieldAutomatorWidgetActions');
  _openai_field_automator_field_widget_form_alter($element, $form_state, $context);
}

