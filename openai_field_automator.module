<?php

/**
 * @file
 * OpenAI Field Automator — auto-populates entity fields with AI-generated
 * content when content is saved.
 *
 * Configuration lives directly on each field's settings form
 * (Structure > Content types > [type] > Manage fields > [field] > Edit).
 * The automator settings are saved as a per-field Backdrop config object:
 *   openai_field_automator.{entity_type}.{bundle}.{field_name}
 */

